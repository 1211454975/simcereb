<?xml version="1.0"?>  
<robot name="humanoid">  
  <!-- 材质定义 -->  
  <material name="blue">  
    <color rgba="0 0 0.8 1"/>  
  </material>  
  <material name="black">  
    <color rgba="0 0 0 1"/>  
  </material>  
  <material name="white">  
    <color rgba="1 1 1 1"/>  
  </material>  
  <material name="red">  
    <color rgba="0.8 0 0 1"/>  
  </material>  
  
  <!-- 基础链接：躯干 -->  
  <link name="torso">  
    <visual>  
      <geometry>  
        <box size="0.2 0.1 0.3"/>  
      </geometry>  
      <material name="blue"/>  
    </visual>  
    <collision>  
      <geometry>  
        <box size="0.2 0.1 0.3"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="10"/>  
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.2"/>  
    </inertial>  
  </link>  
  
  <!-- 头部 -->  
  <link name="head">  
    <visual>  
      <geometry>  
        <sphere radius="0.1"/>  
      </geometry>  
      <material name="white"/>  
    </visual>  
    <collision>  
      <geometry>  
        <sphere radius="0.1"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="1"/>  
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>  
    </inertial>  
  </link>  
  
  <joint name="neck" type="revolute">  
    <parent link="torso"/>  
    <child link="head"/>  
    <origin xyz="0 0 0.2" rpy="0 0 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="-0.5" upper="0.5" effort="100" velocity="1.0"/>  
  </joint>  
  
  <!-- 右臂 -->  
  <link name="right_upper_arm">  
    <visual>  
      <geometry>  
        <cylinder radius="0.03" length="0.2"/>  
      </geometry>  
      <material name="red"/>  
    </visual>  
    <collision>  
      <geometry>  
        <cylinder radius="0.03" length="0.2"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="1"/>  
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/>  
    </inertial>  
  </link>  
  
  <joint name="right_shoulder" type="revolute">  
    <parent link="torso"/>  
    <child link="right_upper_arm"/>  
    <origin xyz="0.15 0 0.1" rpy="0 1.57 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>  
  </joint>  
  
  <link name="right_lower_arm">  
    <visual>  
      <geometry>  
        <cylinder radius="0.025" length="0.2"/>  
      </geometry>  
      <material name="red"/>  
    </visual>  
    <collision>  
      <geometry>  
        <cylinder radius="0.025" length="0.2"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="0.8"/>  
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.002"/>  
    </inertial>  
  </link>  
  
  <joint name="right_elbow" type="revolute">  
    <parent link="right_upper_arm"/>  
    <child link="right_lower_arm"/>  
    <origin xyz="0 0 0.2" rpy="0 0 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="0" upper="2.0" effort="100" velocity="1.0"/>  
  </joint>  
  
  <!-- 左臂 -->  
  <link name="left_upper_arm">  
    <visual>  
      <geometry>  
        <cylinder radius="0.03" length="0.2"/>  
      </geometry>  
      <material name="red"/>  
    </visual>  
    <collision>  
      <geometry>  
        <cylinder radius="0.03" length="0.2"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="1"/>  
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/>  
    </inertial>  
  </link>  
  
  <joint name="left_shoulder" type="revolute">  
    <parent link="torso"/>  
    <child link="left_upper_arm"/>  
    <origin xyz="-0.15 0 0.1" rpy="0 1.57 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>  
  </joint>  
  
  <link name="left_lower_arm">  
    <visual>  
      <geometry>  
        <cylinder radius="0.025" length="0.2"/>  
      </geometry>  
      <material name="red"/>  
    </visual>  
    <collision>  
      <geometry>  
        <cylinder radius="0.025" length="0.2"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="0.8"/>  
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.002"/>  
    </inertial>  
  </link>  
  
  <joint name="left_elbow" type="revolute">  
    <parent link="left_upper_arm"/>  
    <child link="left_lower_arm"/>  
    <origin xyz="0 0 0.2" rpy="0 0 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="0" upper="2.0" effort="100" velocity="1.0"/>  
  </joint>  
  
  <!-- 右腿 -->  
  <link name="right_upper_leg">  
    <visual>  
      <geometry>  
        <cylinder radius="0.04" length="0.3"/>  
      </geometry>  
      <material name="blue"/>  
    </visual>  
    <collision>  
      <geometry>  
        <cylinder radius="0.04" length="0.3"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="4"/>  
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.01"/>  
    </inertial>  
  </link>  
  
  <joint name="right_hip" type="revolute">  
    <parent link="torso"/>  
    <child link="right_upper_leg"/>  
    <origin xyz="0.05 0 -0.2" rpy="0 0 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="-1.0" upper="1.0" effort="100" velocity="1.0"/>  
  </joint>  
  
  <link name="right_lower_leg">  
    <visual>  
      <geometry>  
        <cylinder radius="0.035" length="0.3"/>  
      </geometry>  
      <material name="blue"/>  
    </visual>  
    <collision>  
      <geometry>  
        <cylinder radius="0.035" length="0.3"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="3"/>  
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.01"/>  
    </inertial>  
  </link>  
  
  <joint name="right_knee" type="revolute">  
    <parent link="right_upper_leg"/>  
    <child link="right_lower_leg"/>  
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="0" upper="2.0" effort="100" velocity="1.0"/>  
  </joint>  
  
  <link name="right_foot">  
    <visual>  
      <geometry>  
        <box size="0.1 0.06 0.02"/>  
      </geometry>  
      <material name="black"/>  
    </visual>  
    <collision>  
      <geometry>  
        <box size="0.1 0.06 0.02"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="1"/>  
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.007"/>  
    </inertial>  
  </link>  
  
  <joint name="right_ankle" type="revolute">  
    <parent link="right_lower_leg"/>  
    <child link="right_foot"/>  
    <origin xyz="0 0 -0.15" rpy="0 0 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="-0.5" upper="0.5" effort="100" velocity="1.0"/>  
  </joint>  
  
  <!-- 左腿 -->  
  <link name="left_upper_leg">  
    <visual>  
      <geometry>  
        <cylinder radius="0.04" length="0.3"/>  
      </geometry>  
      <material name="blue"/>  
    </visual>  
    <collision>  
      <geometry>  
        <cylinder radius="0.04" length="0.3"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="4"/>  
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.01"/>  
    </inertial>  
  </link>  
  
  <joint name="left_hip" type="revolute">  
    <parent link="torso"/>  
    <child link="left_upper_leg"/>  
    <origin xyz="-0.05 0 -0.2" rpy="0 0 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="-1.0" upper="1.0" effort="100" velocity="1.0"/>  
  </joint>  
  
  <link name="left_lower_leg">  
    <visual>  
      <geometry>  
        <cylinder radius="0.035" length="0.3"/>  
      </geometry>  
      <material name="blue"/>  
    </visual>  
    <collision>  
      <geometry>  
        <cylinder radius="0.035" length="0.3"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="3"/>  
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.01"/>  
    </inertial>  
  </link>  
  
  <joint name="left_knee" type="revolute">  
    <parent link="left_upper_leg"/>  
    <child link="left_lower_leg"/>  
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="0" upper="2.0" effort="100" velocity="1.0"/>  
  </joint>  
  
  <link name="left_foot">  
    <visual>  
      <geometry>  
        <box size="0.1 0.06 0.02"/>  
      </geometry>  
      <material name="black"/>  
    </visual>  
    <collision>  
      <geometry>  
        <box size="0.1 0.06 0.02"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="1"/>  
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.007"/>  
    </inertial>  
  </link>  
  
  <joint name="left_ankle" type="revolute">  
    <parent link="left_lower_leg"/>  
    <child link="left_foot"/>  
    <origin xyz="0 0 -0.15" rpy="0 0 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="-0.5" upper="0.5" effort="100" velocity="1.0"/>  
  </joint>  
  
  <!-- 添加IMU传感器 -->  
  <link name="imu_link">  
    <visual>  
      <geometry>  
        <box size="0.02 0.02 0.01"/>  
      </geometry>  
      <material name="red"/>  
    </visual>  
    <collision>  
      <geometry>  
        <box size="0.02 0.02 0.01"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="0.01"/>  
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>  
    </inertial>  
  </link>  
  
  <joint name="imu_joint" type="fixed">  
    <parent link="torso"/>  
    <child link="imu_link"/>  
    <origin xyz="0 0 0.1" rpy="0 0 0"/>  
  </joint>  
  
  <!-- 添加力传感器 -->  
  <link name="right_foot_force_sensor">  
    <visual>  
      <geometry>  
        <box size="0.01 0.01 0.005"/>  
      </geometry>  
      <material name="red"/>  
    </visual>  
    <inertial>  
      <mass value="0.001"/>  
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>  
    </inertial>  
  </link>  
  
  <joint name="right_foot_force_joint" type="fixed">  
    <parent link="right_foot"/>  
    <child link="right_foot_force_sensor"/>  
    <origin xyz="0 0 -0.01" rpy="0 0 0"/>  
  </joint>  
  
  <link name="left_foot_force_sensor">  
    <visual>  
      <geometry>  
        <box size="0.01 0.01 0.005"/>  
      </geometry>  
      <material name="red"/>  
    </visual>  
    <inertial>  
      <mass value="0.001"/>  
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>  
    </inertial>  
  </link>  
  
  <joint name="left_foot_force_joint" type="fixed">  
    <parent link="left_foot"/>  
    <child link="left_foot_force_sensor"/>  
    <origin xyz="0 0 -0.01" rpy="0 0 0"/>  
  </joint>  
  
  <!-- 添加手部 -->  
  <link name="right_hand">  
    <visual>  
      <geometry>  
        <box size="0.05 0.08 0.02"/>  
      </geometry>  
      <material name="white"/>  
    </visual>  
    <collision>  
      <geometry>  
        <box size="0.05 0.08 0.02"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="0.2"/>  
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>  
    </inertial>  
  </link>  
  
  <joint name="right_wrist" type="revolute">  
    <parent link="right_lower_arm"/>  
    <child link="right_hand"/>  
    <origin xyz="0 0 0.2" rpy="0 0 0"/>  
    <axis xyz="0 0 1"/>  
    <limit lower="-1.0" upper="1.0" effort="50" velocity="1.0"/>  
  </joint>  
  
  <link name="left_hand">  
    <visual>  
      <geometry>  
        <box size="0.05 0.08 0.02"/>  
      </geometry>  
      <material name="white"/>  
    </visual>  
    <collision>  
      <geometry>  
        <box size="0.05 0.08 0.02"/>  
      </geometry>  
    </collision>  
    <inertial>  
      <mass value="0.2"/>  
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>  
    </inertial>  
  </link>  
  
  <joint name="left_wrist" type="revolute">  
    <parent link="left_lower_arm"/>  
    <child link="left_hand"/>  
    <origin xyz="0 0 0.2" rpy="0 0 0"/>  
    <axis xyz="0 0 1"/>  
    <limit lower="-1.0" upper="1.0" effort="50" velocity="1.0"/>  
  </joint>  
  
  <!-- 添加髋关节的侧向自由度 -->  
  <joint name="right_hip_side" type="revolute">  
    <parent link="torso"/>  
    <child link="right_hip_side_link"/>  
    <origin xyz="0.05 0 -0.15" rpy="0 0 0"/>  
    <axis xyz="1 0 0"/>  
    <limit lower="-0.5" upper="0.5" effort="100" velocity="1.0"/>  
  </joint>  
  
  <link name="right_hip_side_link">  
    <inertial>  
      <mass value="0.01"/>  
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>  
    </inertial>  
  </link>  
  
  <joint name="right_hip_forward" type="revolute">  
    <parent link="right_hip_side_link"/>  
    <child link="right_upper_leg"/>  
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="-1.0" upper="1.0" effort="100" velocity="1.0"/>  
  </joint>  
  
  <joint name="left_hip_side" type="revolute">  
    <parent link="torso"/>  
    <child link="left_hip_side_link"/>  
    <origin xyz="-0.05 0 -0.15" rpy="0 0 0"/>  
    <axis xyz="1 0 0"/>  
    <limit lower="-0.5" upper="0.5" effort="100" velocity="1.0"/>  
  </joint>  
  
  <link name="left_hip_side_link">  
    <inertial>  
      <mass value="0.01"/>  
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>  
    </inertial>  
  </link>  
  
  <joint name="left_hip_forward" type="revolute">  
    <parent link="left_hip_side_link"/>  
    <child link="left_upper_leg"/>  
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="-1.0" upper="1.0" effort="100" velocity="1.0"/>  
  </joint>  
  
  <!-- 添加颈部侧向自由度 -->  
  <joint name="neck_side" type="revolute">  
    <parent link="torso"/>  
    <child link="neck_side_link"/>  
    <origin xyz="0 0 0.15" rpy="0 0 0"/>  
    <axis xyz="1 0 0"/>  
    <limit lower="-0.5" upper="0.5" effort="50" velocity="1.0"/>  
  </joint>  
  
  <link name="neck_side_link">  
    <inertial>  
      <mass value="0.01"/>  
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>  
    </inertial>  
  </link>  
  
  <joint name="neck_forward" type="revolute">  
    <parent link="neck_side_link"/>  
    <child link="head"/>  
    <origin xyz="0 0 0.05" rpy="0 0 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="-0.5" upper="0.5" effort="50" velocity="1.0"/>  
  </joint>  
  
  <!-- 添加肩部侧向自由度 -->  
  <joint name="right_shoulder_side" type="revolute">  
    <parent link="torso"/>  
    <child link="right_shoulder_side_link"/>  
    <origin xyz="0.1 0 0.1" rpy="0 0 0"/>  
    <axis xyz="0 0 1"/>  
    <limit lower="-1.0" upper="1.0" effort="100" velocity="1.0"/>  
  </joint>  
  
  <link name="right_shoulder_side_link">  
    <inertial>  
      <mass value="0.01"/>  
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>  
    </inertial>  
  </link>  
  
  <joint name="right_shoulder_forward" type="revolute">  
    <parent link="right_shoulder_side_link"/>  
    <child link="right_upper_arm"/>  
    <origin xyz="0.05 0 0" rpy="0 1.57 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>  
  </joint>  
  
  <joint name="left_shoulder_side" type="revolute">  
    <parent link="torso"/>  
    <child link="left_shoulder_side_link"/>  
    <origin xyz="-0.1 0 0.1" rpy="0 0 0"/>  
    <axis xyz="0 0 1"/>  
    <limit lower="-1.0" upper="1.0" effort="100" velocity="1.0"/>  
  </joint>  
  
  <link name="left_shoulder_side_link">  
    <inertial>  
      <mass value="0.01"/>  
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>  
    </inertial>  
  </link>  
  
  <joint name="left_shoulder_forward" type="revolute">  
    <parent link="left_shoulder_side_link"/>  
    <child link="left_upper_arm"/>  
    <origin xyz="-0.05 0 0" rpy="0 1.57 0"/>  
    <axis xyz="0 1 0"/>  
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>  
  </joint>  
</robot>